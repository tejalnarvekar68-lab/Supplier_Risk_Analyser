
# Application configuration
APP_API_KEY=replace-with-a-long-random-secret

# Database configuration
DATABASE_URL=sqlite:///./supplier_risk.db

# File upload configuration
MAX_UPLOAD_MB=15

# External research
TAVILY_API_KEY=
RESEARCH_ENABLED=false

# Logging
LOG_LEVEL=INFO

# Embedding configuration
EMBEDDING_MODEL=replace-with-your-embedding-model
EMBEDDING_BASE_URL=replace-with-your-embedding-base-url

# OpenRouter configuration
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Financial extraction model
FINANCIAL_EXTRACTION_MODEL=openai/gpt-4o-mini

#Your Docker Compose file uses POSTGRES_PASSWORD, but your .env.example doesn't currently include it.
POSTGRES_PASSWORD=your_strong_password_here

